# Copy to .env in your local/server environment.
ANTHROPIC_API_KEY=replace-with-a-server-side-key
# Optional: enables Gemini-powered hotel and location search.
GEMINI_API_KEY=replace-with-a-server-side-key
# Optional: enables Google Directions API distance calculations.
GOOGLE_MAPS_API_KEY=replace-with-a-server-side-key
PORT=8787
