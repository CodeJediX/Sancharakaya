# Copy to .env in your local/server environment.
# Required for the Gemini-powered virtual assistant backend.
GEMINI_API_KEY=replace-with-a-server-side-key
# Optional: enables Google Directions API distance calculations.
GOOGLE_MAPS_API_KEY=replace-with-a-server-side-key
PORT=8787
# Comma-separated frontend origins allowed to call the backend.
ALLOWED_ORIGIN=http://localhost:8080,https://codejedix.github.io
RATE_LIMIT_PER_MINUTE=60

# Public Supabase browser config for the main website auth gate.
# Use the publishable/anon browser key only. Never expose a service_role key.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_or_anon_key
