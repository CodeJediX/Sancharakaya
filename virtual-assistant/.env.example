# Copy this file to .env for local development.
# Create a Gemini API key in Google AI Studio and paste it below.
GEMINI_API_KEY=replace-with-your-google-ai-studio-key

# Optional. Leave blank to automatically choose an available Gemini text model.
GEMINI_MODEL=

PORT=8787
ALLOWED_ORIGIN=*

# Set false to disable OpenStreetMap Overpass nearby-business lookup.
ENABLE_NEARBY_OSM=true
